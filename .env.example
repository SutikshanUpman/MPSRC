# Variable NAMES only. Copy to .env (never commit it) on the machine that runs the server.
# Ollama (local, free) needs none of these: install Ollama, `ollama pull <model>`, `ollama serve`.
OLLAMA_HOST=http://127.0.0.1:11434

# OpenAI-compatible API (OpenAI, OpenRouter, vLLM, LM Studio, ...). A localhost OPENAI_BASE_URL is free and needs no key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API (Claude)
ANTHROPIC_API_KEY=

# Metered providers (Anthropic, a remote OpenAI-compatible API) also need these, and "prices_verified": true in config/runtime_config.json.
# Check with: python scripts/live_check.py
LIVE=0
BUDGET_OWNER=

# Console: password (required when HOST is not localhost), bind address, port, data folder (mount a volume there)
CONSOLE_PASSWORD=
PRICES_VERIFIED=0
FINAL_ROUND=0
DATA_DIR=
MAX_QUEUED_RUNS=3
HOST=127.0.0.1
PORT=8000

# Optional model overrides per role for the metered providers (each model needs a price in the runtime config)
MODEL_HEIMDALL=
MODEL_THOR=
MODEL_LOKI=
MODEL_ODIN=
