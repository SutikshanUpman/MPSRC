# Variable NAMES only. Copy to .env (never commit .env) and fill in values on the budget owner's machine.
# The live path runs once, by the budget owner (scripts/live_check.py first, then scripts/run_case.py --provider anthropic).
ANTHROPIC_API_KEY=
LIVE=0
BUDGET_OWNER=
# Dashboard bind address and port (default 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000
# Optional model overrides per role (each model needs a price in config/runtime_config.json)
MODEL_HEIMDALL=
MODEL_THOR=
MODEL_LOKI=
MODEL_ODIN=
