# Variable NAMES only. Copy to .env (never commit it) on the machine that runs the server.
# Ollama (local, free) needs none of these: install Ollama, `ollama pull <model>`, `ollama serve`.
OLLAMA_HOST=http://127.0.0.1:11434

# Anthropic API (Claude)
ANTHROPIC_API_KEY=

# Claude is metered and also needs these, and "prices_verified": true in config/runtime_config.json.
# Check with: python scripts/live_check.py
LIVE=0
BUDGET_OWNER=

# Console: password (required when HOST is not localhost), bind address, port, data folder (mount a volume there)
CONSOLE_PASSWORD=
PRICES_VERIFIED=0
FINAL_ROUND=0
DATA_DIR=
MAX_QUEUED_RUNS=3
HOST=127.0.0.1
PORT=8000

# Optional model overrides per role for Claude (each model needs a price in the runtime config)
MODEL_HEIMDALL=
MODEL_THOR=
MODEL_LOKI=
MODEL_ODIN=
